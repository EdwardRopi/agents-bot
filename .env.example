# Скопировать в .env и заполнить. Файл .env в git не попадает — см. .gitignore.

# Токен бота от @BotFather
BOT_TOKEN=

# Адрес, по которому открывается мини-апп. Telegram требует HTTPS.
# На Render это https://<имя-сервиса>.onrender.com
WEBAPP_URL=

# Postgres. На Render — Internal Database URL.
DATABASE_URL=

# Пароль для локального раннера: по нему твой компьютер забирает задачи
# из очереди и отдаёт результаты. Придумать длинную случайную строку.
RUNNER_TOKEN=

# Твой telegram_id — кому бот шлёт уведомления о новых задачах в очереди.
ADMIN_TELEGRAM_ID=

# Адрес сервиса для локального раннера (tools/inbox.js).
# Локально — http://127.0.0.1:3000, в бою — адрес на Render.
RUNNER_API_URL=http://127.0.0.1:3000

PORT=3000
